{
  "manifest_version": 3,
  "name": "Rokid Meet Device Bridge",
  "version": "0.1.0",
  "description": "Rokid Glasses を Google Meet のカメラ・マイク・スピーカーとして使う (WebRTC ブリッジ)",
  "permissions": ["storage"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Rokid Meet Bridge 設定"
  },
  "content_scripts": [
    {
      "matches": ["https://meet.google.com/*"],
      "js": ["inject.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://meet.google.com/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
